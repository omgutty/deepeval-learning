# DeepEval provider configuration
# Copy this file to .env and fill in your real key:  copy .env.example .env

# Opt into OpenRouter as the active LLM provider
# (Without a USE_*_MODEL flag, deepeval falls back to OpenAI)
USE_OPENROUTER_MODEL=true

# Your OpenRouter API key — note the exact name (OPENROUTER_API_KEY, no extra underscore)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: pick a specific model served by OpenRouter (e.g. anthropic/claude-opus-5)
# Leave empty to use the default judge model: openai/gpt-5.4
# OPENROUTER_MODEL_NAME=
