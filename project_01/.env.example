# ------------------------------------------------------------------
# DeepEval + OpenRouter configuration (template)
# Copy this file to `.env` and fill in your real key:
#   Copy-Item .env.example .env
# `.env` is gitignored and never committed.
# ------------------------------------------------------------------

# Required: your OpenRouter API key (https://openrouter.ai/settings/keys)
# It starts with `sk-or-v1-...`
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-real-key

# Required: make OpenRouter the judge/provider for all LLM-as-a-judge metrics
USE_OPENROUTER_MODEL=1

# Optional: which OpenRouter model slug to use as the default judge.
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL_NAME=openai/gpt-4.1
